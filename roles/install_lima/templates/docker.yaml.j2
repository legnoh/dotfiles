---
# https://github.com/lima-vm/lima/blob/master/templates/default.yaml
base:
  - template:docker

vmType: "vz"

cpus: {{ install_lima_docker_cpus }}
memory: "{{ install_lima_docker_memory }}"
disk: "{{ install_lima_docker_disk }}"

vmOpts:
  vz:
    rosetta:
      enabled: true
      binfmt: true

mounts:
  - location: "~"
    writable: true

{{- if install_lima_enable_external_access }}
portForwards:
  - guestIP: "0.0.0.0"
    guestIPMustBeZero: true
    guestPortRange: [1, 65535]
    hostIP: "0.0.0.0"
    hostPortRange: [1, 65535]
    proto: any
{{- endif }}
